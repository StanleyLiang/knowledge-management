{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "export PATH=/usr/local/bin:$PATH && npm run dev"],
      "port": 3000,
      "cwd": "apps/demo"
    },
    {
      "name": "web",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "export PATH=/usr/local/bin:$PATH && npm run dev"],
      "port": 3002,
      "cwd": "apps/web",
      "autoPort": true
    },
    {
      "name": "rsbuild",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "export PATH=/usr/local/bin:$PATH && npx rsbuild dev --port 3003"],
      "port": 3003,
      "cwd": "apps/rsbuild"
    }
  ]
}
